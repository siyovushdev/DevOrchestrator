# Set identically in WORK's bridge and MCP service environments. No secrets here.
DEVORCHESTRATOR_WORKER=work
# Replace with the exact output of hostname on WORK. Required; HOME must not match.
DEVORCHESTRATOR_WORK_HOST=replace-with-work-hostname
# Required dedicated WORK queue; dev:queued belongs to the legacy HOME bridge.
DEVORCHESTRATOR_QUEUE_LABEL=work:queued
DEVORCHESTRATOR_OWNERS=siyovushdev
DEVORCHESTRATOR_MAX_CODING=1
DEVORCHESTRATOR_MAX_REVIEW=1
DEVORCHESTRATOR_MAX_AGENTS=2
DEVORCHESTRATOR_MACHINE_LIMITS={"work":1,"firefly":1}
DEVORCHESTRATOR_RETENTION_DAYS=30
DEVORCHESTRATOR_ISSUE_RETENTION_DAYS=7
