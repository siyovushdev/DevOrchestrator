+
+    async def test_slow_publication_keeps_polling_and_restart_reconciles_existing_commit(self):
+        loop = ControlLoop(self.h.state)
+        entered, release = asyncio.Event(), asyncio.Event()
+        polls = []
+        async def detached(command):
